# Copy to .env and fill in to enable the real LLM backend (Groq).
# Without GROQ_API_KEY the agent uses a grounded deterministic fallback generator.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Text-to-speech for explanations (Groq Orpheus English). You must also accept the model's
# terms once in the Groq console (playground), otherwise speech calls fail.
# GROQ_TTS_VOICE=troy
# Skill images via Pexels (get a free key at https://www.pexels.com/api/).
# Without it the image tool returns 503 and skills simply show no picture.
PEXELS_API_KEY=
DATABASE_URL=sqlite:///./data/sahlha.db
