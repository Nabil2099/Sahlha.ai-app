# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL=sqlite:///./data/sahlha.db

# --- Auth (JWT). Use a long random value outside local dev. ---
JWT_SECRET=sahlha-dev-secret-change-me-in-production-32
JWT_EXPIRES_MINUTES=10080

# --- Mastery thresholds (student-facing states) ---
MASTERY_DEVELOPING_MIN=0.6
MASTERY_MASTERED_MIN=0.8
MASTERY_MIN_ATTEMPTS=4

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- CORS: extra allowed origins, comma-separated (mobile dev) ---
CORS_EXTRA_ORIGINS=

# --- LLM via Groq (native SDK preferred; OpenAI-compatible fallback). ---
# Without GROQ_API_KEY the agent uses a grounded deterministic fallback generator.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Text-to-speech for explanations (Groq Orpheus English). You must also accept
# the model's terms once in the Groq console, otherwise speech calls fail.
# GROQ_TTS_VOICE=troy

# Skill images via Pexels (free key at https://www.pexels.com/api/).
# Without it the image endpoints return 503 and skills simply show no picture.
PEXELS_API_KEY=

# --- Optional text backup (one failover after transient Groq errors) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
PROVIDER_TIMEOUT_SECONDS=45

# --- Speech providers; existing mobile media contract remains WAV ---
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_TTS_MAX_CHARS=900
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=alloy
# PCM is wrapped as mono signed 16-bit WAV. Match rate to configured provider.
# MP3 requires system ffmpeg to convert to the same WAV contract.
OPENROUTER_TTS_FORMAT=pcm
OPENROUTER_TTS_SAMPLE_RATE=24000

# --- Retrieval: dense is optional; failures use offline TF-IDF ---
DENSE_EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_WARMUP=true
VECTOR_CACHE_PATH=./data/vectors.npz
VECTOR_INCREMENTAL_CHURN=0.35
MMR_LAMBDA=0.7
DENSE_MIN_SCORE=0.05
RETRIEVAL_BACKOFF_RATIO=0.5
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Optional OCR binaries; PATH takes precedence ---
TESSERACT_CMD=
POPPLER_PATH=
OCR_MIN_CHARS=50
# Installed Tesseract language packs; e.g. ara+eng for Arabic/English lessons.
OCR_LANGUAGES=eng
OCR_DPI=250
# Optional sentence-transformers CrossEncoder; failure preserves hybrid ranking.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Needed to verify general semantic MCQs; without it, use verified source completions.
ENABLE_LLM_CRITIQUE=false

# Public old MVP development endpoints are disabled by default.
# Never enable on a shared or production backend.
LEGACY_DEV_API_ENABLED=false
